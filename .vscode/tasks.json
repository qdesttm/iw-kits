{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build.AspNetCore",
			"type": "process",
			"command": "dotnet",
			"args": [
				"build",
				"${config:iWKits.aspNetCore}/AspNetCore.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Run.MongoDb",
			"type" : "process",
			"isBackground": true,
			"command" : "mongod",
			"args" : [
				"--dbpath", "${config:iWKits.mongoDbPath}",
				"--port", "${config:iWKits.mongoDbPort}",
				"--${input:auth}",
				"--quiet"
			],
		},
	],
	"inputs": [
		{
			"id": "auth",
			"description": "Authentification flag",
			"type": "pickString",
			"options": [
				"auth",
				"noauth"
			]
		}
	]
}