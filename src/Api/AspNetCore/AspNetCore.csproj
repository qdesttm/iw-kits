<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPublishable>true</IsPublishable>

		<AssemblyName>IWKits.Api.AspNetCore</AssemblyName>
		<RootNamespace>IWKits.Api.AspNetCore</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Core\Application\Application.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Riok.Mapperly" Version="4.3.1" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="appsettings.json" />

		<None Include="appsettings.json">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="appsettings.Development.json" Condition="Exists('$(ProjectDir)/appsettings.Development.json')">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		<DependentUpon>appsettings.json</DependentUpon>
		</None>
		<Content Update="appsettings.Development.json">
		<DependentUpon>appsettings.json</DependentUpon>
		</Content>
	</ItemGroup>

</Project>
