{
	"logging": {
		"logLevel": {
			"default": "Information",
			"system": "Information",
			"microsoft": "Information"
		},
		"console": {
		"formatterName": "simple",
			"formatterOptions": {
				"singleLine": true,
				"includeScopes": true,
				"timestampFormat": "yyyy-MM-dd HH:mm:ss.fff",
				"useUtcTimestamp": true,
				"jsonWriterOptions": {
				"indented": false
				}
			}
		}
	},
	"allowedHosts": "*",
	"securityTokens": {
		"jwtIssuer": "api",
		"jwtAudience": "app",
		"jwtKey": "",
		"accessTokenLifetime": "00:32:00",
		"refreshTokenLifetime": "23:59:59"
	}
}
